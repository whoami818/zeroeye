#!/usr/bin/env python3
"""
Pre-commit hook for Zeroeye.
Runs build.py, copies diagnostic artifacts to git staging,
and provides a countdown timer during the build.

Usage:
    make install-hooks   # symlinks this script into .git/hooks/pre-commit
    ./tools/pre-commit   # run manually
"""

import hashlib
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOOLS_DIR = ROOT / "tools"
BUILD_SCRIPT = ROOT / "build.py"
DIAGNOSTIC_DIR = ROOT / "diagnostic"

# Marker file so we can skip rebuild when nothing changed
HASH_CACHE = TOOLS_DIR / ".precommit_hash"


def compute_tree_hash(root: Path) -> str:
    """Compute a SHA-256 hash of all .py files in the repo to detect changes."""
    h = hashlib.sha256()
    # Hash all .py files sorted for determinism
    for f in sorted(root.rglob("*.py")):
        # Skip .git and diagnostic dirs
        if ".git" in f.parts or "diagnostic" in f.parts:
            continue
        h.update(str(f).encode())
        h.update(f.read_bytes())
    return h.hexdigest()


def get_latest_diagnostic():
    """Return the most recent .logd and .json files from diagnostic/."""
    logd_files = sorted(DIAGNOSTIC_DIR.glob("build-*.logd"))
    json_files = sorted(DIAGNOSTIC_DIR.glob("build-*.json"))
    latest_logd = logd_files[-1] if logd_files else None
    latest_json = json_files[-1] if json_files else None
    return latest_logd, latest_json


def countdown_timer(process, label="Building"):
    """Display a timer while the subprocess runs."""
    start = time.time()
    while process.poll() is None:
        elapsed = time.time() - start
        mins, secs = int(elapsed) // 60, int(elapsed) % 60
        spinner = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"][int(elapsed * 10) % 10]
        sys.stderr.write(f"\r  {spinner} {label}... {mins:02d}:{secs:02d}")
        sys.stderr.flush()
        time.sleep(0.1)
    sys.stderr.write("\r" + " " * 60 + "\r")
    sys.stderr.flush()
    return process.returncode


def main():
    os.chdir(str(ROOT))

    print("🔍 [pre-commit] Checking if rebuild is needed...")

    # --- Skip logic: nothing changed ---
    current_hash = compute_tree_hash(ROOT)
    if HASH_CACHE.exists():
        cached_hash = HASH_CACHE.read_text().strip()
        if cached_hash == current_hash:
            # Check that diagnostic files still exist
            latest_logd, latest_json = get_latest_diagnostic()
            if latest_logd and latest_logd.exists():
                print("  ✅ No changes detected; using cached diagnostic artifacts.")
                # Still stage them
                if latest_logd and latest_logd.exists():
                    subprocess.run(["git", "add", str(latest_logd)], cwd=str(ROOT), check=False)
                if latest_json and latest_json.exists():
                    subprocess.run(["git", "add", str(latest_json)], cwd=str(ROOT), check=False)
                sys.exit(0)

    # --- Run build.py ---
    print("  🔨 Running build.py (this may take a while)...")
    proc = subprocess.Popen(
        [sys.executable, str(BUILD_SCRIPT)],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    rc = countdown_timer(proc, label="build.py")
    stdout, stderr = proc.communicate()

    if rc != 0:
        print("\n❌ [pre-commit] build.py FAILED — commit aborted.")
        print("── stdout ──")
        print(stdout.decode() if stdout else "(empty)")
        print("── stderr ──")
        print(stderr.decode() if stderr else "(empty)")
        sys.exit(1)

    print("  ✅ build.py completed successfully.")

    # --- Copy diagnostic artifacts to staging ---
    latest_logd, latest_json = get_latest_diagnostic()

    if not latest_logd:
        print("⚠️  [pre-commit] No diagnostic .logd file found. Commit continues.")
    else:
        subprocess.run(["git", "add", str(latest_logd)], cwd=str(ROOT), check=True)
        print(f"  📦 Staged {latest_logd.name}")

    if latest_json and latest_json.exists():
        subprocess.run(["git", "add", str(latest_json)], cwd=str(ROOT), check=True)
        print(f"  📦 Staged {latest_json.name}")

    # --- Update hash cache ---
    HASH_CACHE.write_text(current_hash)

    print("✅ [pre-commit] All checks passed. Proceeding with commit.")


if __name__ == "__main__":
    main()
